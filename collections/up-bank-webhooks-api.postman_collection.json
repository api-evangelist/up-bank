  "item": [
    {
      "id": "8dec6953-09f2-47a2-bf10-3fdc34e8d116",
      "name": "Webhooks",
      "description": {
        "content": "Webhooks provide a mechanism for a configured URL to receive\nevents when transaction activity occurs on Up. You can think of\nwebhooks as being like push notifications for your server-side\napplication.\n",
        "type": "text/plain"
      },
